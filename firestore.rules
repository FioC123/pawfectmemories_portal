rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@pawfect-portal.invalid"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    // Anything not matched below is denied.
    match /{document=**} {
      allow read, write: if false;
    }

    match /Orders/{id} {
      allow read, write: if isAdmin();
    }

    match /Clients/{id} {
      allow read, write: if isAdmin();
    }

    match /Settings/{id} {
      allow read, write: if isAdmin();
    }

    // One document per normalized phone. get is allowed when the caller
    // already knows that phone. list is admin-only, so the collection
    // cannot be downloaded. See SETUP.md for the enumeration tradeoff.
    match /portalByPhone/{phone} {
      allow get: if isAdmin() || phone.matches('^[0-9]{8,15}$');
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
